# Set this to the final public origin before building for production.
# Local Vite forwards /api to localhost:5000. Production must use a same-origin
# reverse proxy or an explicit HTTPS API origin with credentialed CORS configured.
VITE_API_URL=/api/v1
# Example only: VITE_SITE_URL=https://your-domain.example
VITE_SITE_URL=

# Google OAuth 2.0 Client ID (từ Google Cloud Console)
# Ví dụ: 1234567890-abcdefg.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=

# Google Analytics 4 (GA4) Measurement ID (từ Google Analytics)
# Ví dụ: G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=

# Optional: absolute backend origin for Socket.IO (Vercel rewrites cannot proxy WebSockets).
# Without it, production builds skip the socket and poll notifications every 60s.
# VITE_SOCKET_URL=https://<backend>.azurewebsites.net

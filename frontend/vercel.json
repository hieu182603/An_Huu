{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/cach-hoat-dong",
      "destination": "/cach-hoat-dong/index.html"
    },
    {
      "source": "/cach-hoat-dong/",
      "destination": "/cach-hoat-dong/index.html"
    },
    {
      "source": "/mo-phong",
      "destination": "/mo-phong/index.html"
    },
    {
      "source": "/mo-phong/",
      "destination": "/mo-phong/index.html"
    },
    {
      "source": "/tro-ly-ai",
      "destination": "/tro-ly-ai/index.html"
    },
    {
      "source": "/tro-ly-ai/",
      "destination": "/tro-ly-ai/index.html"
    },
    {
      "source": "/kien-thuc",
      "destination": "/kien-thuc/index.html"
    },
    {
      "source": "/kien-thuc/",
      "destination": "/kien-thuc/index.html"
    },
    {
      "source": "/kien-thuc/bat-dau-ke-hoach-huu-tri",
      "destination": "/kien-thuc/bat-dau-ke-hoach-huu-tri/index.html"
    },
    {
      "source": "/kien-thuc/bat-dau-ke-hoach-huu-tri/",
      "destination": "/kien-thuc/bat-dau-ke-hoach-huu-tri/index.html"
    },
    {
      "source": "/kien-thuc/hieu-ve-lam-phat",
      "destination": "/kien-thuc/hieu-ve-lam-phat/index.html"
    },
    {
      "source": "/kien-thuc/hieu-ve-lam-phat/",
      "destination": "/kien-thuc/hieu-ve-lam-phat/index.html"
    },
    {
      "source": "/kien-thuc/hieu-ve-tich-luy",
      "destination": "/kien-thuc/hieu-ve-tich-luy/index.html"
    },
    {
      "source": "/kien-thuc/hieu-ve-tich-luy/",
      "destination": "/kien-thuc/hieu-ve-tich-luy/index.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://anhuu-backend-addwbfcshng0hcf7.japaneast-01.azurewebsites.net/api/$1"
    },
    {
      "source": "/api",
      "destination": "https://anhuu-backend-addwbfcshng0hcf7.japaneast-01.azurewebsites.net/api"
    },
    {
      "source": "/health/(.*)",
      "destination": "https://anhuu-backend-addwbfcshng0hcf7.japaneast-01.azurewebsites.net/health/$1"
    },
    {
      "source": "/health",
      "destination": "https://anhuu-backend-addwbfcshng0hcf7.japaneast-01.azurewebsites.net/health"
    },
    {
      "source": "/((?!assets(?:/|$)|images(?:/|$)|.*\\.[^/]+$).*)",
      "destination": "/app-shell.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/((?!assets/).*\\.(?:png|jpg|jpeg|svg|ico|webp|avif|gif))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}

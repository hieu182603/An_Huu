# 1. Express & Network
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:8443
CORS_ORIGINS=http://127.0.0.1:8443
TRUST_PROXY_HOPS=0
HEALTH_TIMEOUT_MS=1500

# 2. Database (PostgreSQL + Prisma)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/an_huu_db?schema=public"

# 3. Auth & Security (JWT, Cookie & Encryption)
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ISSUER=an-huu-api
JWT_AUDIENCE=an-huu-web
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_SAME_SITE=lax
OUTBOX_ENCRYPTION_KEY=

# 4. Google OAuth 2.0
GOOGLE_CLIENT_ID=

# 5. Google Gemini AI
AI_PROVIDER=none
GEMINI_API_MODE=developer
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=15000
GEMINI_API_KEY=
AI_RETENTION_BATCH_SIZE=100
AI_RETENTION_MAX_BATCHES=10

# 6. Nodemailer (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="An Hưu"

# 7. Cloudinary (Media Storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=anhuu

# 8. Background Jobs & Queue
JOB_TRANSPORT=inline
AZURE_SERVICE_BUS_QUEUE=anhuu-events

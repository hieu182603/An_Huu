# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database - PostgreSQL Connection URL
# Local: postgresql://postgres:postgres@localhost:5432/an_huu_db?schema=public
# Azure Flexible Server: postgresql://anhuuadmin:StrongPass123!@an-huu-postgres.postgres.database.azure.com:5432/an_huu_db?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/an_huu_db?schema=public"

# Authentication (JWT)
JWT_SECRET=an_huu_production_secure_jwt_secret_key_2026_xyz
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=an_huu_production_refresh_token_secret_2026_abc
JWT_REFRESH_EXPIRES_IN=30d

# Cloudinary (Media storage for avatars, article banners, partner logos)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Resend (Transactional email for verification, OTP, password reset, appointment confirmations)
# Lấy API Key tại: https://resend.com/api-keys
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz
EMAIL_FROM="An Hưu <onboarding@resend.dev>" # Hoặc domain riêng: "An Hưu <no-reply@anhuu.vn>"

# Azure Deployment Settings (Optional / Runtime)
WEBSITE_PORT=5000

# Local configuration only. Generate two independent keys before starting:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:8443
CORS_ORIGINS=http://127.0.0.1:8443
# Default 0: do not trust client X-Forwarded-For. Set verified proxy hops on Azure.
TRUST_PROXY_HOPS=0
HEALTH_TIMEOUT_MS=1500

# Matches docker-compose.yml. Production: private endpoint, TLS, separate DB role.
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/an_huu_db?schema=public"

# Required, no default secrets. Values below must be supplied locally/secret manager.
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ISSUER=an-huu-api
JWT_AUDIENCE=an-huu-web
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Integrations are configured when their business modules are enabled.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RESEND_API_KEY=
EMAIL_FROM="An Hưu <onboarding@resend.dev>"

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  PENDING_VERIFICATION
  SUSPENDED
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum ConsultationStatus {
  NEW
  PROCESSING
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
}

enum PartnerType {
  OPEN_FUND
  BANK
  INSURANCE
  SECURITIES
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  fullName     String
  initials     String?
  phone        String?
  city         String?
  avatarUrl    String?
  role         Role       @default(USER)
  status       UserStatus @default(PENDING_VERIFICATION)
  securityVersion Int    @default(0)
  revision        Int    @default(0)
  emailVerifiedAt DateTime?
  lastActiveAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tokens         VerificationToken[]
  refreshTokens  RefreshToken[]
  profile        FinancialProfile?
  onboardingDraft OnboardingDraft?
  goal            RetirementGoal?
  plans           RetirementPlan[]
  simulations    SimulationScenario[]
  trackings      MonthlyTracking[]
  actualMonths   ActualMonth[]
  aiPrivacy      AiPrivacy?
  consultations  Consultation[]       @relation("UserConsultations")
  assignedTasks  Consultation[]       @relation("AdminAssignedConsultations")
  auditLogs      AuditLog[]           @relation("UserAuditLogs")
  aiConversations AiConversation[]
  savedArticles SavedArticle[]
  supportTickets SupportTicket[]
  supportMessages SupportMessage[]
  notifications Notification[]
  notificationPreference NotificationPreference?
  insuranceHistoryVersions SocialInsuranceHistoryVersion[]
  pensionEstimates PensionEstimate[]
  loginLogs      LoginLog[]           @relation("UserLoginLogs")

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique @map("token")
  familyId  String   @default(uuid())
  securityVersion Int @default(0)
  persistent Boolean @default(false)
  usedAt    DateTime?
  revokedAt DateTime?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, revokedAt])
  @@index([familyId])
  @@map("refresh_tokens")
}

model VerificationToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique @map("token")
  attempts  Int       @default(0)
  consumedAt DateTime?
  type      TokenType
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([userId, type, createdAt])
  @@map("verification_tokens")
}

model FinancialProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Các chỉ số tài chính tính toán chính
  readinessScore Int      @default(0) // 0 - 100
  targetFund     Decimal  @default(0) @db.Decimal(18, 2)
  projectedFund  Decimal  @default(0) @db.Decimal(18, 2)
  fundingGap     Decimal  @default(0) @db.Decimal(18, 2)
  monthlySavings Decimal  @default(0) @db.Decimal(18, 2)
  netWorth       Decimal? @db.Decimal(18, 2)

  // Lưu chi tiết các nhánh: personal, income, expenses, assets, debt, socialSecurity, goal
  // Dùng JSONB của PostgreSQL cho tốc độ cao và linh hoạt
  profileData    Json     @db.JsonB
  legacyProfileData Json? @db.JsonB
  schemaVersion  Int      @default(1)
  revision       Int      @default(1)
  completedAt    DateTime?
  asOfDate       DateTime @default(now())
  
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  @@map("financial_profiles")
}

model OnboardingDraft {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  step      String
  data      Json     @db.JsonB
  revision  Int      @default(1)
  updatedAt DateTime @updatedAt
  @@map("onboarding_drafts")
}

model RetirementGoal {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetRetirementAge Int
  lifeExpectancy     Int?
  riskLevel          RiskLevel?
  lifestyle          String
  monthlyExpense     Decimal  @db.Decimal(18, 2)
  monthlyContribution Decimal @db.Decimal(18, 2)
  revision           Int      @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  @@map("retirement_goals")
}

model FinancialModelVersion {
  id           String   @id @default(uuid())
  code         String   @unique
  status       String   @default("DRAFT")
  description  String
  source       Json     @db.JsonB
  createdAt    DateTime @default(now())
  planVersions PlanVersion[]
  @@map("financial_model_versions")
}

model AssumptionSetVersion {
  id           String   @id @default(uuid())
  version      Int      @unique
  status       String   @default("DRAFT")
  revision     Int      @default(1)
  modelCode    String?
  publishedBy  String?
  values       Json     @db.JsonB
  policy       Json     @db.JsonB
  source       Json     @db.JsonB
  reason       String
  createdBy    String
  effectiveAt  DateTime?
  createdAt    DateTime @default(now())
  planVersions PlanVersion[]
  @@map("assumption_set_versions")
}

model RetirementPlan {
  id              String @id @default(uuid())
  userId          String
  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentVersionId String? @unique
  currentVersion  PlanVersion? @relation("CurrentPlanVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  revision        Int @default(0)
  baselineVersionId String? @unique
  baselineVersion PlanVersion? @relation("BaselinePlanVersion", fields: [baselineVersionId], references: [id], onDelete: SetNull)
  stale           Boolean @default(false)
  versions        PlanVersion[] @relation("PlanVersions")
  createdAt       DateTime @default(now())
  @@index([userId, createdAt])
  @@map("retirement_plans")
}

model PlanVersion {
  id                String @id @default(uuid())
  planId            String
  plan              RetirementPlan @relation("PlanVersions", fields: [planId], references: [id], onDelete: Cascade)
  currentFor        RetirementPlan? @relation("CurrentPlanVersion")
  baselineFor       RetirementPlan? @relation("BaselinePlanVersion")
  version           Int
  profileRevision   Int
  goalRevision      Int
  modelVersionId    String
  model             FinancialModelVersion @relation(fields: [modelVersionId], references: [id])
  assumptionVersionId String
  assumptions       AssumptionSetVersion @relation(fields: [assumptionVersionId], references: [id])
  inputSnapshot     Json @db.JsonB
  result            Json @db.JsonB
  chartSeries       Json @db.JsonB
  asOfDate          DateTime
  createdAt         DateTime @default(now())
  @@unique([planId, version])
  @@map("plan_versions")
}

model OutboxEvent {
  id          String   @id @default(uuid())
  type        String
  entityId    String
  payload     Json     @db.JsonB
  status      String   @default("PENDING")
  attempts    Int      @default(0)
  availableAt DateTime @default(now())
  leaseId     String?
  lockedUntil DateTime?
  lastErrorCode String?
  createdAt   DateTime @default(now())
  completedAt DateTime?
  @@index([status, availableAt])
  @@map("outbox_events")
}

model ProcessedEvent {
  eventId     String @id
  processedAt DateTime @default(now())
  @@map("processed_events")
}

model IdempotencyRecord {
  id        String @id @default(uuid())
  userId    String
  scope     String
  key       String
  requestHash String
  response  Json @db.JsonB
  createdAt DateTime @default(now())
  @@unique([userId, scope, key])
  @@map("idempotency_records")
}

model SimulationScenario {
  id                  String   @id @default(uuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                String   @default("Kịch bản mới")
  isBaseline          Boolean  @default(false)
  targetRetireAge     Int
  monthlyContribution Decimal  @db.Decimal(18, 2)
  annualReturnRate    Decimal  @db.Decimal(5, 2)
  annualInflationRate Decimal  @db.Decimal(5, 2)
  
  // Kết quả tính toán của kịch bản
  resultSummary       Json     @db.JsonB
  createdAt           DateTime @default(now())

  @@index([userId])
  @@map("simulation_scenarios")
}

model MonthlyTracking {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  period       String   // Format: YYYY-MM
  targetAmount Decimal  @db.Decimal(18, 2)
  actualAmount Decimal  @db.Decimal(18, 2)
  status       String   @default("ON_TRACK") // ON_TRACK, NEEDS_ATTENTION, BEHIND
  notes        String?
  createdAt    DateTime @default(now())

  @@unique([userId, period])
  @@map("monthly_trackings")
}

model Consultation {
  id              String             @id @default(uuid())
  userId          String
  user            User               @relation("UserConsultations", fields: [userId], references: [id], onDelete: Cascade)
  userName        String
  userEmail       String
  userPhone       String
  userAge         Int?
  userFund        String?
  topic           String
  details         String             @db.Text
  preferredTime   String?
  appointmentAt   DateTime?
  status          ConsultationStatus @default(NEW)
  assignedAdminId String?
  assignedAdmin   User?              @relation("AdminAssignedConsultations", fields: [assignedAdminId], references: [id])
  notes           String?            @db.Text
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@map("consultations")
}

model Article {
  id          String        @id @default(uuid())
  title       String
  slug        String        @unique
  excerpt     String        @db.Text
  content     String        @db.Text
  category    String
  authorName  String
  thumbnail   String?       // Cloudinary URL
  status      ArticleStatus @default(DRAFT)
  viewCount   Int           @default(0)
  kind        String        @default("ARTICLE")
  searchText  String        @default("") @db.Text
  revision    Int           @default(0)
  publishedAt DateTime?
  savedBy     SavedArticle[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([kind, status])
  @@map("articles")
}

model SavedArticle {
  userId String
  articleId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@id([userId, articleId])
  @@map("saved_articles")
}

model SupportTicket {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject String
  category String
  status String @default("OPEN")
  revision Int @default(0)
  messages SupportMessage[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId, updatedAt])
  @@index([status, updatedAt])
  @@map("support_tickets")
}

model SupportMessage {
  id String @id @default(uuid())
  ticketId String
  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId String
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body String @db.Text
  createdAt DateTime @default(now())
  @@index([ticketId, createdAt])
  @@map("support_messages")
}

model Notification {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  title String
  message String
  path String
  readAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model Partner {
  id           String           @id @default(uuid())
  name         String
  type         PartnerType
  logoUrl      String?          // Cloudinary URL
  contactEmail String?
  website      String?
  isHighlight  Boolean          @default(false)
  isVisible    Boolean          @default(false)
  revision     Int              @default(0)
  products     PartnerProduct[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@map("partners")
}

model PartnerProduct {
  id             String    @id @default(uuid())
  partnerId      String
  partner        Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  name           String
  category       String
  expectedReturn String
  riskLevel      RiskLevel @default(MEDIUM)
  description    String?   @db.Text
  annualFee      String?   @db.Text
  conditions     String?   @db.Text
  disclosure     String?   @db.Text
  imageUrl       String?   // Cloudinary URL
  isVisible      Boolean   @default(false)
  revision       Int       @default(0)
  updatedAt      DateTime  @default(now()) @updatedAt
  createdAt      DateTime  @default(now())

  @@map("partner_products")
}

model FinancialAssumption {
  id               String   @id @default(uuid())
  code             String   @unique
  name             String
  category         String
  currentValue     Decimal  @db.Decimal(10, 2)
  unit             String
  recommendedRange String?
  description      String?  @db.Text
  updatedBy        String
  updatedAt        DateTime @updatedAt

  @@map("financial_assumptions")
}

model AuditLog {
  id            String   @id @default(uuid())
  action        String
  targetType    String
  targetId      String?
  performerId   String?
  performerName String
  ipAddress     String?
  userAgent     String?
  details       Json?    @db.JsonB
  createdAt     DateTime @default(now())

  performer     User?    @relation("UserAuditLogs", fields: [performerId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
  @@index([targetType, targetId, createdAt])
  @@index([createdAt])
}

model SystemSetting {
  key       String   @id
  value     Json     @db.JsonB
  category  String   @default("GENERAL")
  updatedBy String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([category])
  @@map("system_settings")
}

enum LoginStatus {
  SUCCESS
  FAILED
  LOCKED
}

model LoginLog {
  id            String      @id @default(uuid())
  userId        String?
  identifier    String
  status        LoginStatus
  ipAddress     String?
  userAgent     String?
  failureReason String?
  createdAt     DateTime    @default(now())

  user          User?       @relation("UserLoginLogs", fields: [userId], references: [id], onDelete: SetNull)

  @@index([identifier, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
  @@map("login_logs")
}

enum SystemLogLevel {
  INFO
  WARNING
  ERROR
  CRITICAL
}

model SystemLog {
  id         String         @id @default(uuid())
  level      SystemLogLevel @default(INFO)
  source     String
  message    String         @db.Text
  path       String?
  statusCode Int?
  traceId    String?
  details    Json?          @db.JsonB
  createdAt  DateTime       @default(now())

  @@index([level, createdAt])
  @@index([source, createdAt])
  @@index([createdAt])
  @@map("system_logs")
}

enum KnowledgeStatus {
  PENDING
  PROCESSING
  INDEXED
  FAILED
}

model KnowledgeSource {
  id            String          @id @default(uuid())
  title         String
  referenceCode String?
  category      String
  description   String?         @db.Text
  rawContent    String?         @db.Text
  fileUrl       String?
  fileSize      Int?
  mimeType      String?
  version       String          @default("1.0")
  effectiveDate DateTime?
  status        KnowledgeStatus @default(PENDING)
  isApproved    Boolean         @default(false)
  errorMessage  String?
  chunks        KnowledgeChunk[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  revision      Int             @default(0)
  validUntil    DateTime?
  indexedHash   String?

  @@map("knowledge_sources")
}

model KnowledgeChunk {
  id         String          @id @default(uuid())
  sourceId   String
  source     KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  chunkIndex Int
  content    String          @db.Text
  metadata   Json?           @db.JsonB
  embedding  Unsupported("vector(1536)")?
  createdAt  DateTime        @default(now())

  @@index([sourceId])
  @@map("knowledge_chunks")
}

model AiConversation {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String      @default("Cuộc trò chuyện mới")
  messages  AiMessage[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  revision  Int         @default(0)
  expiresAt DateTime?

  @@index([userId, createdAt])
  @@map("ai_conversations")
}

model AiMessage {
  id             String         @id @default(uuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String         @db.Text
  citedSources   Json?          @db.JsonB
  tokensUsed     Int?
  createdAt      DateTime       @default(now())
  requestKey     String?
  context        Json?

  @@index([conversationId, createdAt])
  @@unique([conversationId, requestKey, role])
  @@map("ai_messages")
}

model LegalRuleSetVersion {
  id String @id @default(uuid())
  code String
  version Int
  revision Int @default(1)
  status String @default("DRAFT")
  effectiveFrom DateTime @db.Date
  effectiveTo DateTime? @db.Date
  knowledgeAsOf DateTime @default(now()) @db.Timestamptz(3)
  supersedesId String?
  supersedes LegalRuleSetVersion? @relation("RuleSupersession", fields: [supersedesId], references: [id], onDelete: Restrict)
  successors LegalRuleSetVersion[] @relation("RuleSupersession")
  document Json @db.JsonB
  documentHash String
  validation Json? @db.JsonB
  review Json? @db.JsonB
  createdBy String
  authorIds String[]
  reviewedBy String?
  publishedBy String?
  publishedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  estimates PensionEstimate[]
  @@unique([code, version])
  @@index([code, status, effectiveFrom])
  @@map("legal_rule_set_versions")
}

model SocialInsuranceHistoryVersion {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  revision Int
  parentVersionId String?
  parentHash String?
  parent SocialInsuranceHistoryVersion? @relation("InsuranceHistoryChain", fields: [parentVersionId, userId], references: [id, userId], onDelete: NoAction, onUpdate: NoAction)
  successors SocialInsuranceHistoryVersion[] @relation("InsuranceHistoryChain")
  recordedAt DateTime @default(now()) @db.Timestamptz(3)
  schemaVersion Int @default(1)
  document Json @db.JsonB
  documentHash String
  estimates PensionEstimate[]
  @@unique([userId, revision])
  @@unique([id, userId])
  @@map("social_insurance_history_versions")
}

model PensionEstimate {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  historyVersionId String
  history SocialInsuranceHistoryVersion @relation(fields: [historyVersionId, userId], references: [id, userId], onDelete: Cascade, onUpdate: NoAction)
  legalRuleSetVersionId String
  legalRule LegalRuleSetVersion @relation(fields: [legalRuleSetVersionId], references: [id], onDelete: Restrict)
  engineCode String
  inputHash String
  inputSnapshot Json @db.JsonB
  result Json @db.JsonB
  integrityHash String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([userId, createdAt])
  @@map("pension_estimates")
}

model NotificationPreference {
  userId         String @id
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)
  revision       Int @default(1)
  emailDigest    Boolean @default(false)
  goalAlerts     Boolean @default(false)
  partnerUpdates Boolean @default(false)
  updatedAt      DateTime @updatedAt
  @@map("notification_preferences")
}

model AiPrivacy {
  userId         String @id
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)
  revision       Int @default(1)
  processing     Boolean @default(false)
  saveHistory    Boolean @default(false)
  policyVersion  String
  updatedAt      DateTime @updatedAt
  @@map("ai_privacy")
}

model ActualMonth {
  id        String @id @default(uuid())
  userId    String
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  period    String
  revision  Int
  payload   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  history   ActualMonthRevision[]
  events    ActualEventIdentity[]
  @@unique([userId, period])
  @@map("actual_months")
}

model ActualMonthRevision {
  id        String @id @default(uuid())
  monthId   String
  month     ActualMonth @relation(fields: [monthId], references: [id], onDelete: Cascade)
  revision  Int
  payload   Json
  createdAt DateTime @default(now())
  @@unique([monthId, revision])
  @@map("actual_month_revisions")
}

// Stable identities remain reserved even when an entry is removed by a correction.
model ActualEventIdentity {
  id      String @id @default(uuid())
  userId  String
  eventId String
  monthId String
  month   ActualMonth @relation(fields: [monthId], references: [id], onDelete: Cascade)
  @@unique([userId, eventId])
  @@map("actual_event_identities")
}

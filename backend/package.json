{
  "name": "an-huu-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API for An Huu Financial & Retirement Planning Platform",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --watch src --exec ts-node src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "worker": "node dist/worker.js",
    "worker:dev": "ts-node src/worker.ts",
    "retention:check": "node dist/retention.js",
    "retention:run": "node dist/retention.js --execute",
    "db:seed": "node scripts/seed.cjs",
    "admin:bootstrap": "node scripts/bootstrap-admin.cjs",
    "legal:corpus:check": "node scripts/generate-legal-corpus.cjs --check && vitest run src/tests/legal-corpus.test.ts --maxWorkers=2",
    "test:local-db": "node scripts/test-local-db.cjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "db:test:prepare": "node scripts/prepare-test-db.cjs",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "verify": "npm run typecheck && npm run typecheck:tests && npm test && npm run build && npm run test:startup",
    "test:startup": "node scripts/check-production-startup.cjs"
  },
  "dependencies": {
    "@azure/identity": "4.13.3",
    "@azure/service-bus": "7.9.5",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "2.11.0",
    "compression": "1.8.2",
    "cookie": "1.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "google-auth-library": "^11.1.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "10.2.1",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "12.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "8.0.2",
    "@types/supertest": "^6.0.2",
    "ajv": "8.20.0",
    "nodemon": "^3.1.9",
    "prisma": "^5.22.0",
    "socket.io-client": "4.8.4",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "vitest": "4.1.11",
    "yaml": "2.9.1"
  },
  "overrides": {
    "@azure/msal-node": "^7.1.2"
  }
}

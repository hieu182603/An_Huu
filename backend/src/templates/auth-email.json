{
  "html": "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\">\n<html xmlns=\"http://www.w3.org/1999/xhtml\" lang=\"vi\">\n<head>\n<meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n<title>{{{SUBJECT}}}</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap\" rel=\"stylesheet\">\n<style type=\"text/css\">\n  @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap');\n  body, table, td, a { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }\n  table, td { mso-table-lspace: 0pt; mso-table-rspace: 0pt; }\n  img { -ms-interpolation-mode: bicubic; border: 0; outline: none; text-decoration: none; }\n  body, table, td, div, p, span, a, h1, h2, h3, b, small {\n    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;\n  }\n  body { margin: 0; padding: 0; width: 100% !important; background-color: #edf5fa; color: #0b2b57; }\n\n  @media only screen and (max-width: 620px) {\n    .email-container { width: 100% !important; border-radius: 18px !important; }\n    .email-wrapper-cell { padding: 6px 4px 18px 4px !important; }\n    \n    /* Header mobile */\n    .header-pad { padding: 18px 18px !important; }\n    .header-tag { font-size: 9.5px !important; line-height: 13px !important; letter-spacing: 0.3px !important; }\n    .header-secure-text { font-size: 10.5px !important; letter-spacing: 0.6px !important; }\n    .header-shield { width: 26px !important; height: 30px !important; line-height: 30px !important; font-size: 15px !important; margin-left: 4px !important; }\n    \n    /* Hero mobile */\n    .hero-pad { padding: 22px 18px 14px 18px !important; }\n    .hero-title { font-size: 26px !important; line-height: 1.2 !important; margin: 0 0 10px 0 !important; }\n    .hero-hello { font-size: 16px !important; margin-bottom: 6px !important; }\n    .hero-desc { font-size: 13px !important; line-height: 1.45 !important; }\n    .hero-img { width: 100% !important; max-width: 125px !important; }\n\n    /* Content / OTP Card mobile */\n    .content-pad { padding: 0 12px 20px 12px !important; }\n    .card-pad { padding: 22px 12px 20px 12px !important; border-radius: 20px !important; }\n    .section-title-td { font-size: 11.5px !important; letter-spacing: 2px !important; padding: 0 8px !important; }\n    .digits-table { margin: 16px auto 16px auto !important; }\n    .digit-cell { width: 44px !important; height: 56px !important; font-size: 30px !important; line-height: 56px !important; border-radius: 11px !important; }\n    \n    /* Expiry banner mobile */\n    .expiry-table { padding: 10px 16px !important; border-radius: 18px !important; margin-top: 14px !important; }\n    .expiry-clock { width: 38px !important; height: 38px !important; font-size: 18px !important; border-radius: 11px !important; }\n    .expiry-label { font-size: 10px !important; letter-spacing: 0.8px !important; }\n    .expiry-value { font-size: 22px !important; margin-top: 1px !important; }\n    .card-note { font-size: 12px !important; margin-top: 14px !important; }\n\n    /* 3 Security cards mobile - stay 3 columns */\n    .info-card-container { padding: 14px 4px !important; border-radius: 18px !important; margin-top: 16px !important; }\n    .info-col { padding: 0 4px !important; }\n    .info-icon { width: 36px !important; height: 36px !important; line-height: 36px !important; font-size: 18px !important; border-radius: 10px !important; margin-bottom: 6px !important; }\n    .info-title { font-size: 11.5px !important; margin-bottom: 3px !important; letter-spacing: -0.2px !important; }\n    .info-desc { font-size: 9.5px !important; line-height: 1.35 !important; }\n\n    /* Footer mobile - stay 3 columns */\n    .footer-pad { padding: 18px 12px 14px 12px !important; }\n    .footer-brand { font-size: 16px !important; }\n    .footer-tag { font-size: 8px !important; line-height: 1.25 !important; }\n    .footer-col-1 { width: 28% !important; padding-right: 6px !important; }\n    .footer-col-2 { width: 42% !important; padding: 0 6px !important; font-size: 9.5px !important; line-height: 1.6 !important; }\n    .footer-col-3 { width: 30% !important; padding-left: 6px !important; font-size: 9px !important; line-height: 1.35 !important; }\n    .footer-copy { font-size: 9.5px !important; padding-top: 8px !important; }\n    .footer-slash { font-size: 11px !important; padding-top: 8px !important; }\n  }\n</style>\n</head>\n<body style=\"margin:0;padding:20px 0;background-color:#edf5fa;font-family:'Plus Jakarta Sans',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#0b2b57;\">\n<div style=\"display:none;max-height:0;overflow:hidden;opacity:0;color:transparent;font-size:1px;line-height:1px;\">{{{PREVIEW_TEXT}}}</div>\n<table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#edf5fa\" style=\"background-color:#edf5fa;margin:0;padding:0;\">\n  <tr>\n    <td align=\"center\" class=\"email-wrapper-cell\" style=\"padding:10px 12px 30px 12px;\">\n      <table width=\"640\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" class=\"email-container\" style=\"width:640px;max-width:640px;background-color:#ffffff;border-radius:28px;overflow:hidden;box-shadow:0 12px 36px rgba(13,46,89,0.08);border:1px solid #d8e5ee;\">\n        \n        <!-- HEADER -->\n        <tr>\n          <td class=\"header-pad\" style=\"background-color:#0d2f5c;background-image:linear-gradient(135deg,#0d4c92 0%,#0d2f5c 55%,#0a3159 100%);padding:22px 32px;\">\n            <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n              <tr>\n                <td align=\"left\" valign=\"middle\">\n                  <div style=\"font-size:24px;font-weight:800;letter-spacing:0.5px;color:#ffffff;line-height:1;\">AN HƯU</div>\n                  <div class=\"header-tag\" style=\"font-size:11px;letter-spacing:0.5px;color:#cfe2f7;margin-top:5px;font-weight:600;\">GIẢI PHÁP SỐ HÓA QUẢN LÝ HIỆU QUẢ</div>\n                </td>\n                <td align=\"right\" valign=\"middle\" style=\"white-space:nowrap;\">\n                  <span class=\"header-secure-text\" style=\"font-size:12px;letter-spacing:1px;font-weight:700;color:#ffffff;vertical-align:middle;\">XÁC THỰC BẢO MẬT</span>\n                  <span class=\"header-shield\" style=\"display:inline-block;margin-left:8px;width:30px;height:34px;background:#34b7a8;background-image:linear-gradient(#70e1d0,#34b7a8);border-radius:8px;text-align:center;line-height:34px;color:#ffffff;font-size:17px;font-weight:900;vertical-align:middle;\">✓</span>\n                </td>\n              </tr>\n            </table>\n          </td>\n        </tr>\n\n        <!-- HERO SECTION -->\n        <tr>\n          <td class=\"hero-pad\" style=\"background-color:#f9fdfc;background-image:linear-gradient(160deg,#ffffff 0%,#f4fbf9 55%,#ddf6f1 100%);padding:30px 32px 18px 32px;\">\n            <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n              <tr>\n                <td width=\"60%\" valign=\"middle\" align=\"left\" style=\"width:60%;padding-right:8px;\">\n                  <div style=\"display:inline-block;background:#dff6ee;border-radius:24px;padding:6px 14px;color:#13816f;font-weight:700;letter-spacing:1px;font-size:11.5px;margin-bottom:12px;\">✉ &nbsp; {{{EYEBROW}}}</div>\n                  <div class=\"hero-title\" style=\"font-size:36px;line-height:1.18;font-weight:800;letter-spacing:-0.5px;color:#0d2b57;margin:0 0 12px 0;\">{{{HEADING_HTML}}}</div>\n                  <div class=\"hero-hello\" style=\"font-size:18px;font-weight:700;color:#0d2b57;margin-bottom:6px;\">Xin chào {{{CUSTOMER_NAME}}},</div>\n                  <div class=\"hero-desc\" style=\"font-size:14.5px;line-height:1.55;color:#4f6b88;margin:0;\">{{{INTRO_TEXT}}}</div>\n                </td>\n                <td width=\"40%\" valign=\"middle\" align=\"right\" style=\"width:40%;\">\n                  <img src=\"https://res.cloudinary.com/dinpwy33h/image/upload/v1791359664/anhuu/otp-email-hero.jpg\" width=\"220\" class=\"hero-img\" style=\"display:block;width:100%;max-width:220px;height:auto;border:0;\" alt=\"Xác thực email\" />\n                </td>\n              </tr>\n            </table>\n          </td>\n        </tr>\n\n        <!-- CONTENT / OTP CARD -->\n        <tr>\n          <td class=\"content-pad\" style=\"background-color:#f8fcff;padding:0 28px 28px 28px;\">\n            <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" class=\"card-pad\" style=\"background-color:#ffffff;border-radius:24px;border:1px solid #dce8f2;box-shadow:0 12px 32px rgba(35,84,128,0.08);margin-top:8px;padding:30px 24px 26px 24px;\">\n              <tr>\n                <td>\n                  \n                  <!-- Section Title with Lines -->\n                  <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin-bottom:16px;\">\n                    <tr>\n                      <td style=\"border-bottom:2px solid #d3e7f7;width:26%;\"></td>\n                      <td align=\"center\" class=\"section-title-td\" style=\"padding:0 14px;font-size:13px;font-weight:800;letter-spacing:3px;color:#082c5b;white-space:nowrap;text-transform:uppercase;\">{{{CODE_LABEL}}}</td>\n                      <td style=\"border-bottom:2px solid #d3e7f7;width:26%;\"></td>\n                    </tr>\n                  </table>\n\n                  <!-- ACTION_HTML (Digits or CTA) -->\n                  {{{ACTION_HTML}}}\n\n                  <!-- Expiry Banner -->\n                  <table align=\"center\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" class=\"expiry-table\" style=\"background:#e7faf7;border:1px solid #d0f0e7;border-radius:24px;margin:18px auto 0 auto;padding:12px 24px;\">\n                    <tr>\n                      <td align=\"center\" valign=\"middle\" class=\"expiry-clock\" style=\"width:44px;height:44px;background:#cff5ea;border-radius:14px;font-size:22px;color:#0c7c6b;text-align:center;\">◷</td>\n                      <td valign=\"middle\" style=\"padding-left:12px;\">\n                        <div class=\"expiry-label\" style=\"font-size:11px;font-weight:700;letter-spacing:1px;color:#13816f;text-transform:uppercase;\">{{{EXPIRY_LABEL}}}</div>\n                        <div class=\"expiry-value\" style=\"font-size:26px;font-weight:800;color:#06295a;line-height:1.2;margin-top:1px;\">{{{OTP_EXPIRE_MINUTES}}} phút</div>\n                      </td>\n                    </tr>\n                  </table>\n\n                  <!-- Note -->\n                  <div class=\"card-note\" style=\"text-align:center;color:#6b82a6;font-size:13px;line-height:1.5;margin-top:18px;\">{{{SECURITY_NOTICE}}}</div>\n\n                </td>\n              </tr>\n            </table>\n\n            <!-- 3 SECURITY INFO CARDS (Consistent 3 Columns on both Desktop & Mobile) -->\n            <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" class=\"info-card-container\" style=\"background-color:#ffffff;border:1px solid #d7e7f4;border-radius:20px;margin-top:22px;box-shadow:0 6px 20px rgba(13,46,89,0.03);padding:18px 8px;\">\n              <tr>\n                <td>\n                  <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n                    <tr>\n                      <td width=\"33.3%\" class=\"info-col\" valign=\"top\" align=\"center\" style=\"width:33.3%;padding:0 10px;text-align:center;\">\n                        <div class=\"info-icon\" style=\"width:44px;height:44px;border-radius:14px;background:#e4f8f2;display:inline-block;text-align:center;line-height:44px;font-size:22px;margin:0 auto 10px auto;\">🔒</div>\n                        <div class=\"info-title\" style=\"font-size:14px;font-weight:700;color:#082a55;margin-bottom:6px;letter-spacing:-0.2px;\">Bảo mật tuyệt đối</div>\n                        <div class=\"info-desc\" style=\"font-size:12px;line-height:1.45;color:#7184a2;\">Mã OTP chỉ dùng cho một lần xác thực.</div>\n                      </td>\n                      <td width=\"33.3%\" class=\"info-col\" valign=\"top\" align=\"center\" style=\"width:33.3%;padding:0 10px;border-left:1px solid #dceaf4;text-align:center;\">\n                        <div class=\"info-icon\" style=\"width:44px;height:44px;border-radius:14px;background:#e7f3ff;display:inline-block;text-align:center;line-height:44px;font-size:22px;margin:0 auto 10px auto;\">🛡️</div>\n                        <div class=\"info-title\" style=\"font-size:14px;font-weight:700;color:#082a55;margin-bottom:6px;letter-spacing:-0.2px;\">Không chia sẻ mã</div>\n                        <div class=\"info-desc\" style=\"font-size:12px;line-height:1.45;color:#7184a2;\">Không chia sẻ mã OTP với bất kỳ ai.</div>\n                      </td>\n                      <td width=\"33.3%\" class=\"info-col\" valign=\"top\" align=\"center\" style=\"width:33.3%;padding:0 10px;border-left:1px solid #dceaf4;text-align:center;\">\n                        <div class=\"info-icon\" style=\"width:44px;height:44px;border-radius:14px;background:#e4f8f2;display:inline-block;text-align:center;line-height:44px;font-size:22px;margin:0 auto 10px auto;\">✉️</div>\n                        <div class=\"info-title\" style=\"font-size:14px;font-weight:700;color:#082a55;margin-bottom:6px;letter-spacing:-0.2px;\">Do An Hưu gửi</div>\n                        <div class=\"info-desc\" style=\"font-size:12px;line-height:1.45;color:#7184a2;\">Nếu bạn không yêu cầu mã này, vui lòng bỏ qua email này.</div>\n                      </td>\n                    </tr>\n                  </table>\n                </td>\n              </tr>\n            </table>\n\n          </td>\n        </tr>\n\n        <!-- FOOTER (Consistent 3 Columns on both Desktop & Mobile) -->\n        <tr>\n          <td class=\"footer-pad\" style=\"background-color:#0b284e;background-image:linear-gradient(120deg,#0d315d 0%,#08284e 68%,#073252 100%);color:#ffffff;padding:26px 32px 22px 32px;\">\n            <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n              <tr>\n                <td width=\"30%\" class=\"footer-col-1\" valign=\"middle\" style=\"width:30%;padding-right:12px;\">\n                  <div class=\"footer-brand\" style=\"font-size:20px;font-weight:800;color:#ffffff;letter-spacing:0.4px;\">AN HƯU</div>\n                  <div class=\"footer-tag\" style=\"font-size:10px;color:#a9bdd3;letter-spacing:0.4px;margin-top:3px;font-weight:600;\">GIẢI PHÁP SỐ HÓA QUẢN LÝ HIỆU QUẢ</div>\n                </td>\n                <td width=\"40%\" class=\"footer-col-2\" valign=\"middle\" style=\"width:40%;padding:0 12px;border-left:1px solid rgba(255,255,255,0.2);font-size:12px;line-height:1.8;\">\n                  <span style=\"color:#ffffff;white-space:nowrap;display:inline-block;\">🌐 <a href=\"https://an-huu.vercel.app\" style=\"color:#ffffff;text-decoration:none;\">an-huu.vercel.app</a></span><br />\n                  <span style=\"color:#ffffff;white-space:nowrap;display:inline-block;\">✉ <a href=\"mailto:anhuuofficial@gmail.com\" style=\"color:#ffffff;text-decoration:none;\">anhuuofficial@gmail.com</a></span>\n                </td>\n                <td width=\"30%\" class=\"footer-col-3\" valign=\"middle\" style=\"width:30%;padding-left:12px;border-left:1px solid rgba(255,255,255,0.2);font-size:12px;line-height:1.45;color:#ffffff;\">\n                  Đồng hành cùng doanh nghiệp trong hành trình chuyển đổi số\n                </td>\n              </tr>\n              <tr>\n                <td colspan=\"2\" class=\"footer-copy\" style=\"border-top:1px solid rgba(255,255,255,0.2);padding-top:12px;margin-top:16px;color:#a9bdd3;font-size:11px;\">\n                  © {{{YEAR}}} An Hưu. All rights reserved.\n                </td>\n                <td align=\"right\" class=\"footer-slash\" style=\"border-top:1px solid rgba(255,255,255,0.2);padding-top:12px;margin-top:16px;color:#3cd4b8;font-size:14px;font-weight:700;letter-spacing:2px;font-style:italic;\">\n                  ////\n                </td>\n              </tr>\n            </table>\n          </td>\n        </tr>\n\n      </table>\n    </td>\n  </tr>\n</table>\n</body>\n</html>"
}